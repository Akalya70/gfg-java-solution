class Solution {
    public int powMod(int x, int n, int M) {
        long ans = 1;
        long base = x % M;

        while (n > 0) {
            if (n % 2 == 1) {
                ans = (ans * base) % M;
            }
            base = (base * base) % M;
            n = n / 2;
        }
        return (int) ans;
    }
}
