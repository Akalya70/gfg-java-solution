class Solution {
    public static int[] lcmAndGcd(int a, int b) {

        int originalA = a;
        int originalB = b;
        while (a > 0 && b > 0) {
            if (a > b)
                a = a % b;
            else
                b = b % a;
        }

        int gcd;

        if (a == 0)
            gcd = b;
        else
            gcd = a;
        int lcm = (originalA * originalB) / gcd;

        return new int[]{lcm, gcd};
    }
}
