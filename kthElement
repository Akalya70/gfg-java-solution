class Solution {
    public int kthElement(int a[], int b[], int k) {
        int n = a.length;
              int m = b.length;
              int[] merged = new int[n + m];
              for (int i = 0; i < n; i++) {
                  merged[i] = a[i];
              }
              for (int i = 0; i < m; i++) {
                  merged[n + i] = b[i];
              }
              Arrays.sort(merged);
              return merged[k - 1];
        
    }
}
