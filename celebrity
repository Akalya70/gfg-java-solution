class Solution {
    public int celebrity(int mat[][]) {
        int n = mat.length;
        int top = 0;
        int down = n - 1;

        while (top < down) {
            if (mat[top][down] == 1) {
                top++;
            } else {
                down--;
            }
        }

        int cand = top;

        for (int i = 0; i < n; i++) {
            if (i == cand) continue;
            if (mat[cand][i] == 1 || mat[i][cand] == 0) {
                return -1;
            }
        }

        return cand;
    }
}
