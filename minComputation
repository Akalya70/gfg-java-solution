class Solution {
    public int minComputation(int[] files) {
        int ans=0;
              PriorityQueue<Integer> pq=new PriorityQueue<>();
              for(int i:files){
                  pq.offer(i);
              }
              while(pq.size()>1){
                  int out=pq.poll()+pq.poll();
                  ans+=out;
                  pq.offer(out);
              }
              return ans;
        
    }
}
