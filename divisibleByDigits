class Solution {
    public int divisibleByDigits(String s) {
        int[] countMap = new int[10];
        for (int i = 0; i < s.length(); i++) {
            int digit = s.charAt(i) - '0';
            countMap[digit]++;
        }

        int totalCount = 0;
        for (int digit = 1; digit <= 9; digit++) {
            if (countMap[digit] > 0) {
                long remainder = 0;
                for (int i = 0; i < s.length(); i++) {
                    int currentDigit = s.charAt(i) - '0';
                    remainder = (remainder * 10 + currentDigit) % digit;
                }
                if (remainder == 0) {
                    totalCount += countMap[digit];
                }
            }
        }

        return totalCount;
    }
}
