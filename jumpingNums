class Solution {
    static long jumpingNums(long n) {
        if (n <= 10) {
            return n;
        }
        for (long i = n; i >= 0; i--) {
            if (isJumping(i)) {
                return i;
            }
        }
        return 0;
    }
    static boolean isJumping(long num) {
        if (num <= 9) {
            return true;
        }

        while (num > 0) {
            long digit1 = num % 10;
            num /= 10;

            if (num == 0) {
                break;
            }

            long digit2 = num % 10;
            if (Math.abs(digit1 - digit2) != 1) {
                return false;
            }
        }
        return true;
    }
}
