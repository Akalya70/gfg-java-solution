import java.util.HashMap;

class Solution {
    public int firstElementKTime(int[] arr, int k) {
        HashMap<Integer, Integer> frequencyMap = new HashMap<>();

        for (int num : arr) {
            int count = frequencyMap.getOrDefault(num, 0) + 1;
            frequencyMap.put(num, count);
            if (count == k) {
                return num;
            }
        }
        return -1;
    }
}
