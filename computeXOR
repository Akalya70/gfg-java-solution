class Solution {

    private int computeXOR(int n) {
        int mod = n % 4;
        if (mod == 0) return n;
        if (mod == 1) return 1;
        if (mod == 2) return n + 1;
        return 0; 
    }

    public int findXOR(int l, int r) {
        return computeXOR(r) ^ computeXOR(l - 1);
    }
}
