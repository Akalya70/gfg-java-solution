class Solution {
    public void segregateElements(int[] arr) {
        int k=0;
              int arr1[]=new int[arr.length];
              for(int i=0;i<arr.length;i++)
              {
                  if(arr[i]>=0){
                      arr1[k]=arr[i];
                      k++;
                  }
              }
              for(int i=0;i<arr.length;i++)
              {
                  if(arr[i]<0){
                      arr1[k]=arr[i];
                      k++;
                  }
              }
              for(int i=0;i<arr.length;i++)
              {
                  arr[i]=arr1[i];
              }
        
    }
}
