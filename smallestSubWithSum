class Solution {
    public int smallestSubWithSum(int[] arr, int x) {
        int n = arr.length;
        int minLen = n + 1;
        long currentSum = 0;
        int left = 0;

        for (int right = 0; right < n; right++) {
            currentSum += arr[right];

            // Shrink window from the left while sum remains strictly greater than x
            while (currentSum > x) {
                minLen = Math.min(minLen, right - left + 1);
                currentSum -= arr[left];
                left++;
            }
        }

        return (minLen == n + 1) ? 0 : minLen;
    }
}
