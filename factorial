class Solution {
    public ArrayList<Integer> factorial(int n) {
        ArrayList<Integer> list=new ArrayList();
                list.add(1);

                for(int i=2;i<=n;i++){
                    solve(list,i);
                }

                Collections.reverse(list);
                return list;
            }
            public void solve(ArrayList<Integer> list,int num){
                int carry=0;

                for(int i=0;i<list.size();i++){
                    int curr=list.get(i)*num + carry;
                    carry=curr/10;
                    list.set(i,curr%10);
                }

                while(carry!=0){
                    list.add(carry%10);
                    carry/=10;
                }
        
    }
}
