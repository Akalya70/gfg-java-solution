class Solution {
    public int missingNumber(int[] arr) {
        int n = arr.length;
        int i = 0;

        while (i < n) {
            int val = arr[i];
            if (val >= 1 && val <= n && arr[val - 1] != val) {
                int temp = arr[i];
                arr[i] = arr[val - 1];
                arr[val - 1] = temp;
            } else {
                i++;
            }
        }
        for (i = 0; i < n; i++) {
            if (arr[i] != i + 1) {
                return i + 1;
            }
        }

        return n + 1;
    }
}
