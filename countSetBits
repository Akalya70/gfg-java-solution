class Solution {
    public static int countSetBits(int n) {
        if (n == 0) {
            return 0;
        }

        // Largest power of 2 <= n (x such that 2^x <= n)
        int x = largestPowerOfTwo(n);
        int pow2 = 1 << x;

        // 1. Bits in [1, 2^x - 1]: x * 2^(x - 1)
        int bitsBeforePow2 = x * (pow2 >> 1);

        // 2. Leading 1-bit at position x for [2^x, n]: (n - pow2 + 1)
        int leadingBits = n - pow2 + 1;

        // 3. Remaining lower bits in [2^x, n] match [0, n - pow2]
        int rest = countSetBits(n - pow2);

        return bitsBeforePow2 + leadingBits + rest;
    }

    private static int largestPowerOfTwo(int n) {
        int x = 0;
        while ((1 << (x + 1)) <= n) {
            x++;
        }
        return x;
    }
}
