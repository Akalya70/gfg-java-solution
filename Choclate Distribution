class Solution {
    public int findMinDiff(int arr[], int m) {
        int n=arr.length;
            Arrays.sort(arr);
            int mindiff=Integer.MAX_VALUE;
            for(int i=0;i+m-1<n;i++)
            {
                 int currdiff=arr[i+m-1]-arr[i];
                 mindiff=Math.min(mindiff,currdiff);
            }
        return mindiff;
    }
}
