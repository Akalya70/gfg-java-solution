
class Solution 
{
    public String largestNumber(int n, int sum){
        if (sum > 9 * n)
        {
            return "-1";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++)
        {
            if (sum >= 9)
            {
                sb.append(9);
                sum -= 9;
            }
            else
            {
                sb.append(sum);
                sum = 0;
            }
        }
        return sb.toString();
    }
}
