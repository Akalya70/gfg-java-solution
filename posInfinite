import java.util.ArrayList;
import java.util.List;

class Solution {
    public char posInfinite(String s, int pos) {
        long curPos = pos;

        // Track length after each step: len[0] = s.length()
        List<Long> len = new ArrayList<>();
        len.add((long) s.length());

        int step = 0;
        while (len.get(step) < curPos) {
            step++;
            // New length = old + i dollars + reversed old
            len.add(len.get(step - 1) * 2 + step);
        }

        // Walk backward from 'step' down to 1
        for (int i = step; i >= 1; i--) {
            long prevLen = len.get(i - 1);
            long dollarEnd = prevLen + i;

            if (curPos <= prevLen) {
                // Already in the left half; curPos stays the same
            } else if (curPos <= dollarEnd) {
                // Landed on one of the '$' characters
                return '$';
            } else {
                // Landed in the reversed right half; mirror back to left half
                long revIndex = curPos - dollarEnd; // 1-based position in reversed part
                curPos = prevLen - revIndex + 1;
            }
        }

        return s.charAt((int) curPos - 1);
    }
}
