class Solution {
    public int sum(int a, int b) {
        // Iterate until there is no carry left
        while (b != 0) {
            // Find carry bits
            int carry = (a & b) << 1;
            
            // Sum without considering carry
            a = a ^ b;
            
            // Assign carry to b so it can be added in the next iteration
            b = carry;
        }
        return a;
    }
}
