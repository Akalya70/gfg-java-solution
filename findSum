class Solution {
    String findSum(String s1, String s2) {
        StringBuilder sb = new StringBuilder();
        int i = s1.length() - 1;
        int j = s2.length() - 1;
        int carry = 0;

        while (i >= 0 || j >= 0 || carry > 0) {
            int sum = carry;

            if (i >= 0) {
                sum += s1.charAt(i) - '0';
                i--;
            }

            if (j >= 0) {
                sum += s2.charAt(j) - '0';
                j--;
            }

            carry = sum / 10;
            sb.append(sum % 10);
        }

        sb.reverse();

        int idx = 0;
        while (idx < sb.length() - 1 && sb.charAt(idx) == '0') {
            idx++;
        }

        return sb.substring(idx);
    }
}
