class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        long n = arr.length;
        long sumN = (n * (n + 1)) / 2;
        long sumSqN = (n * (n + 1) * (2 * n + 1)) / 6;

        long sumArr = 0;
        long sumSqArr = 0;

        for (int i = 0; i < n; i++) {
            sumArr += arr[i];
            sumSqArr += (long) arr[i] * arr[i];
        }
        long val1 = sumArr - sumN;
        long val2 = sumSqArr - sumSqN;

        long val3 = val2 / val1;

        int repeating = (int) ((val1 + val3) / 2);
        int missing = (int) (repeating - val1);

        ArrayList<Integer> result = new ArrayList<>();
        result.add(repeating);
        result.add(missing);

        return result;
    }
}
