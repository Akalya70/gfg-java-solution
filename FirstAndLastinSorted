class Solution {
    ArrayList<Integer> find(int arr[], int x) {
       ArrayList<Integer> list = new ArrayList<>();
                int n = arr.length;
                int first = -1;
                int second = -1;
                for(int i=0;i<n;i++){
                    if(arr[i]==x){
                        first = i;
                        break;
                    }
                }
                for(int i=n-1;i>=0;i--){
                     if(arr[i]==x){
                        second = i;
                        break;
                    }
                }
                list.add(first);
                list.add(second);
                return list;
        
    }
}
