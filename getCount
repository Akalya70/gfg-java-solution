class Solution {
    int getCount(String s, int k) {
        int n = s.length();
        if (n == 0) return 0;
        int[] groupCount = new int[26];
        int i = 0;
        while (i < n) {
            char currentChar = s.charAt(i);
            groupCount[currentChar - 'a']++;

            while (i < n && s.charAt(i) == currentChar) {
                i++;
            }
        }

        int result = 0;
        for (int count : groupCount) {
            if (count == k) {
                result++;
            }
        }

        return result;
    }
}
